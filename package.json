{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:backend": "pnpm --dir backend dev",
    "dev:all": "concurrently \"pnpm dev:backend\" \"pnpm dev\"",
    "db:link": "npx supabase link --project-ref mobroigpqtsfbfbvmvwa",
    "db:push": "npx supabase db push",
    "db:migrate": "node backend/scripts/migrate_pg.mjs",
    "typecheck": "tsc --noEmit && pnpm --dir backend typecheck",
    "build": "vite build",
    "ci": "pnpm typecheck && pnpm build",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "^5.1.8",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0"
  }
}
